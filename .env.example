# NoneBot only listens locally by default. Keep this when NapCat is on the same host.
HOST=127.0.0.1
PORT=8080

# Optional on loopback, strongly recommended when the connection crosses hosts.
# Use the same value in NapCat WebUI -> 网络配置 -> WebSocket 客户端 -> Token.
ONEBOT_ACCESS_TOKEN=

LOG_LEVEL=INFO

