# NoneBot only listens locally by default. Keep this when NapCat is on the same host.
HOST=127.0.0.1
PORT=8080

# Optional on loopback, strongly recommended when the connection crosses hosts.
# Use the same value in NapCat WebUI -> 网络配置 -> WebSocket 客户端 -> Token.
ONEBOT_ACCESS_TOKEN=

LOG_LEVEL=INFO


# NAS bot-owned archive. Credentials remain local; user NAS saving is deferred.
NAS_ARCHIVE_ENABLED=false
NAS_HOST=192.168.124.3
NAS_PORT=22
NAS_USERNAME=qqbot
NAS_PASSWORD=
NAS_KNOWN_HOSTS=artifacts/runtime/nas-known-hosts
NAS_ARCHIVE_BYTES=10000000
NAS_ARCHIVE_MAX_WAIT=86400

# Only after remote hash verification; true keeps local copies instead.
NAS_ARCHIVE_KEEP_LOCAL=false
